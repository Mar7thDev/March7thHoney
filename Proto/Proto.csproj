<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>March7thHoney.Proto</AssemblyName>
    <RootNamespace>March7thHoney.Proto</RootNamespace>
    <ActiveProtocolVersion>4.6</ActiveProtocolVersion>
    <!-- MSBuild owns schema freshness, including deleted inputs and missing outputs. -->
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    <!-- Only the generated C# for the ACTIVE game version is compiled. The grouped .proto sources
         (Proto/<version>/), the Raw dumps, the curated ProtoFile/ library, and the ProtoOrganizer
         tool all live under Proto/ but must NOT be swept into this assembly. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.33.1" />
    <PackageReference Include="Google.Protobuf.Tools" Version="3.33.1" PrivateAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <Import Project="Build/GenerateProtobuf.targets" />

</Project>
