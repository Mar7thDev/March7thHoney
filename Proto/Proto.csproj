<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>March7thHoney.Proto</AssemblyName>
    <RootNamespace>March7thHoney.Proto</RootNamespace>
    <!-- Only the C# generated from StarRail.proto is compiled. The ProtoOrganizer tool lives under
         Proto/Tool as a project of its own and must not be swept into this assembly. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- MSBuild checks removed schemas and missing generated outputs. -->
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Google.Protobuf.Tools" PrivateAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <Import Project="Build/GenerateProtobuf.targets" />

</Project>
