{
  "HttpServer": {
    "BindAddress": "0.0.0.0",
    "PublicAddress": "dispatch.example.com",
    "Port": 21000,
    "UseSSL": false
  },
  "GameServer": {
    "GameServerName": "HoyoToon Dispatch",
    "UsePacketEncryption": false
  },
  "Database": {
    "DatabaseType": "sqlite",
    "DatabaseName": "March7thHoney-dispatch.db"
  },
  "ServerOption": {
    "Auth": {
      "EnableRegistration": true,
      "SendVerificationEmailOnRegister": false,
      "RequireVerifiedEmailForLogin": false,
      "Email": {
        "Enabled": false,
        "PublicBaseUrl": "https://dispatch.example.com"
      }
    },
    "LogOption": {
      "EnableGamePacketLog": true
    },
    "ServerConfig": {
      "RunDispatch": true,
      "FromDispatchBaseUrl": "",
      "ServerExchangeSecret": "CHANGE_ME_SHARED_REGION_SECRET",
      "RunGateway": false,
      "DefaultRegionName": "hoyotoon_hsr_na",
      "Regions": [
        {
          "GateWayAddress": "https://na-gateway.example.com/query_gateway",
          "GameServerName": "HoyoToon Live NA",
          "GameServerId": "hoyotoon_hsr_na",
          "EnvType": 2
        },
        {
          "GateWayAddress": "https://eu-gateway.example.com/query_gateway",
          "GameServerName": "HoyoToon Live EU",
          "GameServerId": "hoyotoon_hsr_eu",
          "EnvType": 2
        }
      ]
    }
  },
  "MuipServer": {
    "AdminKey": "CHANGE_ME_ADMIN_KEY"
  },
  "WebSecurity": {
    "EnableRsaLoginDecrypt": true,
    "RsaPrivateKeyPem": ""
  }
}
