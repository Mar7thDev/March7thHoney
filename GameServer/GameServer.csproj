    <Compile Remove="Game\GridFight\**\*.cs" />
    <Compile Remove="Server\Packet\Recv\GridFight\**\*.cs" />
    <Compile Remove="Server\Packet\Send\GridFight\**\*.cs" />
    <Compile Remove="Server\Packet\Recv\DiceCombat\**\*.cs" />
    <Compile Remove="Server\Packet\Send\DiceCombat\**\*.cs" />
    <Compile Remove="Game\Activity\Activities\DiceCombat\**\*.cs" />
