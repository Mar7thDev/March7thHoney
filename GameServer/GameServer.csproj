    <Compile Remove="Server\Packet\Send\TrainParty\**\*.cs" />
    <Compile Remove="Game\TrainParty\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Common\Common.csproj" />
