<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>March7thHoney.GameServer</RootNamespace>
    <StartupObject></StartupObject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>March7thHoney.GameServer</AssemblyName>
    <ApplicationIcon>March7thHoney.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
	  <Content Include="March7thHoney.ico" />
  </ItemGroup>

  <!-- TODO 4.3: 仅小游戏模块 (货币战争/骰子战斗/火车蛋糕/火车派对) 仍因 proto 大量变更暂时排除编译。
       其余模块 (Mail/JukeBox/Pet/Phone/PlayerBoard/Gacha/Expedition/Item/Friend/RechargeGift/Player 等)
       已在 4.3 适配混淆名变更后恢复编译。 -->
