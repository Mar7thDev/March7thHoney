<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>March7thHoney.GameServer</RootNamespace>
    <StartupObject></StartupObject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>March7thHoney.GameServer</AssemblyName>
    <ApplicationIcon>March7thHoney.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
	  <Content Include="March7thHoney.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Common\Common.csproj" />
    <ProjectReference Include="..\KcpSharp\KcpSharp.csproj" />
    <ProjectReference Include="..\Proto\Proto.csproj" />
    <ProjectReference Include="..\ServerSideProto\ServerSideProto.csproj" />
    <PackageReference Include="Google.Protobuf" Version="3.33.1" />
    <PackageReference Include="Google.Protobuf.Tools" Version="3.33.1" />
    <PackageReference Include="McMaster.NETCore.Plugins" Version="2.0.0" />
    <PackageReference Include="McMaster.NETCore.Plugins.Mvc" Version="2.0.0" />
    <PackageReference Include="System.IO.Pipelines" Version="10.0.0" />
  </ItemGroup>

  <!-- Temporary: disable modules that depend on missing 4.2 proto definitions. -->
  <ItemGroup>
    <Compile Remove="Game\ChallengePeak\**\*.cs" />
    <Compile Remove="Server\Packet\Send\ChallengePeak\**\*.cs" />
    <Compile Remove="Server\Packet\Recv\ChallengePeak\**\*.cs" />
    <Compile Remove="Game\Challenge\Instances\ChallengePeakInstance.cs" />
    <Compile Remove="Server\Packet\Recv\Gacha\HandlerSetGachaDecideItemCsReq.cs" />
    <Compile Remove="Server\Packet\Send\Gacha\PacketSetGachaDecideItemScRsp.cs" />
    <Compile Remove="Server\Packet\Recv\Item\HandlerLockEquipmentCsReq.cs" />
    <Compile Remove="Server\Packet\Send\Item\PacketLockEquipmentScRsp.cs" />
  </ItemGroup>

</Project>

