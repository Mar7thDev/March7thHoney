<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>March7thHoney</RootNamespace>
    <AssemblyName>March7thHoney.Common</AssemblyName>
  </PropertyGroup>

  <!--
    Limited-mode builds: -p:LimitedMode=true compiles the server with its embedded configuration and the
    startup activation gate (see docs/operations/limited-mode.md). The three Activation* properties name the
    service such a build is activated against; whoever distributes their own builds overrides them.
  -->
  <PropertyGroup>
    <DefineConstants Condition="'$(LimitedMode)' == 'true'">$(DefineConstants);LIMITED_MODE</DefineConstants>
    <ActivationServerUrl Condition="'$(ActivationServerUrl)' == ''">https://cyrene.hoyotoon.com</ActivationServerUrl>
    <ActivationPublicKey Condition="'$(ActivationPublicKey)' == ''">MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAE0B8BahOmnSrpcrz64ReTq75XAiTrrs+PrHBtQp7ImtYnnj/Pvkly2EEbeqTLml9eq238gUwUOcfuIOHw78wujg==</ActivationPublicKey>
    <ActivationHelpUrl Condition="'$(ActivationHelpUrl)' == ''">discord.gg/CyreneEchoes</ActivationHelpUrl>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="ActivationServerUrl" Value="$(ActivationServerUrl)" />
    <AssemblyMetadata Include="ActivationPublicKey" Value="$(ActivationPublicKey)" />
    <AssemblyMetadata Include="ActivationHelpUrl" Value="$(ActivationHelpUrl)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EastAsianWidth" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Google.Protobuf.Tools" />
    <PackageReference Include="MemoryPack" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <!-- Override transitive SQLitePCLRaw 2.1.x (vulnerable native SQLite, GHSA-2m69-gcr7-jv3q) with the 3.x line. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <PackageReference Include="MySqlConnector" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="System.Management" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\Config\Custom\ResourceCompatibility\AvatarSkins.json" LogicalName="March7thHoney.ResourceCompatibility.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Proto\Proto.csproj" />
    <ProjectReference Include="..\SourceGen\SourceGen.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>


